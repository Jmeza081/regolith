<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest is the app's static declaration to the OS: which "pages"
  (Activities) exist, which one is the entry point, and what the app is
  allowed to do. Compose apps have one Activity and draw every screen in it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMB and LAN discovery need the network. Local-network permission
         (Android 16+/17) is added in Phase 6 with the discovery flow. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".RegolithApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Regolith.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Regolith.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
