<!-- The status-bar icon for every notification the app posts (downloads,
     the scan, the artwork walk). The same wedge as ic_splash_wordmark, but
     that one is drawn on a 108dp adaptive-icon canvas with the launcher's
     safe-zone margin, so as a small icon it filled barely 40% of the slot
     and read as a speck. Here it fills a 24dp frame to the standard 1dp
     inset. Android draws small icons as a white silhouette from the alpha
     channel alone, so the fill colour is irrelevant beyond being opaque. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path android:fillColor="#FFFFFF" android:pathData="M1.92,1 L22.08,12 L1.92,23 Q6.5,12 1.92,1 Z" />
</vector>
